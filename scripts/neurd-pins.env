# NeurD header pins (Leia media_sdk), one KEY=value per line, read by
# scripts/build-linux.sh and checked against the workflows and
# scripts/build-windows.bat by scripts/check_pins.py (lint).
#
# These pin the PUBLIC HEADERS the provider is compiled against, fetched from the
# private LeiaInc/media_sdk repo at build time and never committed. They are not
# the NeurD runtime: that is an external prerequisite the provider finds on the
# box (docs/conversion-provider.md), with its own installer, licence and models.
#
# Windows (D3D11 transport): the last release whose headers the DX path needs.
# Linux (CPU transport): the first release with NeurD_convert_stream_cpu_ex
# (look-around, float depth) and NeurD_get_table_size (the table guard).
# Linux fallback: the last release WITHOUT cpu_ex; CI compiles the fixed-pair
# fallback build against it so that path stays compiled.
NEURD_SDK_REPO=LeiaInc/media_sdk
NEURD_SDK_REF_WINDOWS=v0.4.10
NEURD_SDK_REF_LINUX=v0.5.0
NEURD_SDK_REF_LINUX_FALLBACK=v0.4.10
